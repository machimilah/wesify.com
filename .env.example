# Copy to .env.local and fill in. .env.local is gitignored; this file is not, so it must never
# contain a real secret.
#
# BO runs with none of these set. Each one turns something on rather than being required:
# no DATABASE_URL or no Clerk keys means no accounts, and no ANTHROPIC_API_KEY means the interview
# runs in the browser.

# --- Database (Supabase) -----------------------------------------------------
# Supabase dashboard > Project Settings > Database > Connection string > URI.
# Use the "Session pooler" URI for a long-running server. The password is the database password you
# set when creating the project, not the publishable key.
#
# BO connects to Postgres directly and owns its own schema, so it runs as the database user rather
# than through PostgREST. Row Level Security is therefore not what protects a workspace — the account
# check in the server is. See server/index.mjs, tenant().
DATABASE_URL=postgresql://postgres.your-project-ref:YOUR-DB-PASSWORD@aws-0-your-region.pooler.supabase.com:6543/postgres

# Set to "off" only for a local Postgres with no TLS.
# DATABASE_SSL=off

# --- Identity (Clerk) --------------------------------------------------------
# Clerk holds the credential: sign-up, sign-in, email verification, password reset and signing out
# everywhere all happen there. BO stores no password and issues no session token of its own — it
# keeps one row per person in `users`, keyed by the Clerk user id, so that a workspace, a membership
# and a subscription have something to belong to.
#
# Both keys come from the Clerk dashboard (clerk.com > API keys). The database is the other half of
# accounts: with one and not the other, nobody can sign in, and the server says so at start.
CLERK_SECRET_KEY=
# Compiled into the browser bundle by Vite. Public by design — it names the Clerk instance and
# authorises nothing on its own.
VITE_CLERK_PUBLISHABLE_KEY=

# --- Supabase client (optional) ----------------------------------------------
# Only needed if BO later uses Supabase Storage, Realtime or Edge Functions from the browser. The
# publishable key is designed to be public. Nothing in BO reads these yet.
# VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# --- Interview model ---------------------------------------------------------
# With a key, the interview runs on the server: instant, any browser, and the questions are about
# this company rather than a fixed list asked of everyone. Without one, BO falls back to a small
# model in the browser and, failing that, to its built-in questions.
#
# Either key turns the interview on. Gemini is the free one: https://aistudio.google.com/apikey,
# no card, sign in with a Google account, "Create API key", paste it below.
GEMINI_API_KEY=
# BO_GEMINI_MODEL=gemini-3.7-flash
# The free tier meters per model, so when the newest one runs out of quota BO moves down this list
# rather than dropping the operator back to its built-in questions.
# BO_GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.6-flash,gemini-3.1-flash-lite,gemini-3-flash-preview

# Anthropic additionally powers the web-search research pass, which Gemini alone does not run.
# Set both and Anthropic runs the interview; BO_INTERVIEW_PROVIDER=gemini forces the free one.
ANTHROPIC_API_KEY=
# BO_REASONING_MODEL=claude-sonnet-
# BO_INTERVIEW_PROVIDER=gemini

# --- Deploying everything on Vercel ------------------------------------------
# api/[...path].mjs runs BO's own router as a Vercel function, so the keys above work there and
# VITE_API_URL is not needed: the interface and the API share one origin, as they do locally.
#
# DATABASE_URL stops being optional. Vercel's filesystem is read-only apart from /tmp, and /tmp does
# not survive between invocations, so without Postgres every workspace is lost the moment the
# function goes cold.
#
# --- Split deployment (frontend and API on different hosts) -------------------
# Only needed when the interface is served by something that cannot run BO's server — Vercel,
# Netlify, any static CDN. On a laptop and in the container one process serves both, and neither of
# these is set.
#
# Set on the FRONTEND deployment. Vite inlines it at build time, so it is compiled into JavaScript
# anyone can read: it is an address, never a secret. Unset, the interface calls its own origin.
# VITE_API_URL=https://api.example.com
#
# Set on the API deployment: which browser origins may call it. Comma-separated, exact matches plus
# one optional wildcard label, because a static host gives every preview build its own hostname.
# Nothing is allowed until this names it, so forgetting it fails closed rather than open.
# BO_ALLOWED_ORIGINS=https://your-app.vercel.app,https://*.vercel.app

# --- Cost and abuse limits ---------------------------------------------------
# /api/discovery/turn cannot ask for a workspace token: it is the call that creates the workspace.
# Until accounts are enforced everywhere, these are the defence against the address of a deployment
# being enough to spend its owner's model budget.
# BO_MODEL_RATE_LIMIT=20
# BO_DAILY_MODEL_CALLS=500

# --- Connected apps ----------------------------------------------------------
# Encrypts stored third-party credentials. Without it BO refuses to store any, rather than writing
# them in plain text. Use a long random string.
BO_CONNECTION_SECRET=

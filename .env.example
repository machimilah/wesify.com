# Wesify environment. Copy to .env.local for development. Validated at startup by src/server/env.ts:
# production refuses to boot when a required value is missing or a pair is half-set.
# Staging and production use SEPARATE values for everything below (docs/deployment.md).

# ---- Core --------------------------------------------------------------------------------
# development | staging | production. Staging is noindex and allows staging-only admin tools.
APP_ENV=
# Public base URL. Canonical links, email links and OAuth redirects are built from it. Required in production.
APP_URL=
# Owner admin token for /admin and internal routes (24+ random chars). Dev default: "dev-admin".
ADMIN_TOKEN=
# HMAC secret for unsubscribe links and hashed IPs (32+ random chars). Required in production.
SESSION_SECRET=
# 32 random bytes, base64 (`openssl rand -base64 32`). Encrypts platform OAuth tokens. Required in production.
TOKEN_ENCRYPTION_KEY=
# Scheduler auth for /api/internal/cron (`Authorization: Bearer ...`). Required in production.
CRON_SECRET=

# ---- Storage and backups (§34, §55) ------------------------------------------------------
# Where the state file lives (default ./.data). Must be persistent disk in production.
WESIFY_DATA_DIR=
# Where hourly backups go (default $WESIFY_DATA_DIR/backups). Put this on a different volume/bucket mount.
BACKUP_DIR=
# 32 bytes base64. When set, backups are AES-256-GCM encrypted. Store this key outside the server too.
BACKUP_ENCRYPTION_KEY=

# ---- Auth: Clerk (§4). Set both, or neither to use the built-in email/password login ---------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Optional custom Clerk frontend API domain (added to the CSP), e.g. https://clerk.wesify.app
CLERK_FRONTEND_API=

# ---- Bot protection: Cloudflare Turnstile (§28). Set both, or neither ----------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---- Email: Resend (§50). Without it, emails are logged instead of sent ---------------------
RESEND_API_KEY=
# e.g. "Wesify <hello@mail.wesify.app>" (a domain with SPF, DKIM and DMARC set up)
EMAIL_FROM=
# Optional separate sender for marketing email
EMAIL_FROM_MARKETING=
SUPPORT_EMAIL=
SECURITY_EMAIL=

# ---- Monitoring (§42, §70) ---------------------------------------------------------------
# Slack/Discord-compatible webhook for founder alerts (provider failures, backups, integrity, security).
ALERT_WEBHOOK_URL=
# Shown next to usage counters in /admin → Health.
MONTHLY_BUDGET_USD=
LOG_LEVEL=

# ---- Metrics providers (§16) -------------------------------------------------------------
# Provider for pasted-link markets: mock (simulated) | manual. Switch without code changes.
METRICS_PROVIDER=mock
# Set to 0 to skip TikTok oEmbed lookups (thumbnails, author, private/deleted check).
TIKTOK_OEMBED=

# ---- Creator accounts (§5, §31). Leave empty to use simulated connections -----------------
# Redirect URIs to register: {APP_URL}/api/social/{tiktok|instagram|youtube}/callback
# TikTok Login Kit (web). Scopes: user.info.basic, user.info.profile, user.info.stats, video.list
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Instagram API with Instagram Login (Business/Creator accounts). Scope: instagram_business_basic
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_GRAPH_VERSION=v21.0
# Google OAuth + YouTube Data API v3. Scope: youtube.readonly
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
